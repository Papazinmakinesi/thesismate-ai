// ThesisMate AI – Prisma schema
// Uses SQLite for local MVP development (no PostgreSQL required)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Thesis settings – single record holding the user's thesis metadata and custom API configs
model Thesis {
  id                String             @id @default(cuid())
  title             String
  topic             String
  aim               String
  researchQuestions String             // stored as JSON string for SQLite compatibility
  apiKey            String             @default("") // custom user API key for live GPT-4 / Gemini RAG queries
  apiModel          String             @default("gpt-4o-mini") // active model selection
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sources           Source[]
  comments          Comment[]
  matrices          LiteratureMatrix[]
  drafts            ThesisDraft[]
}

// Full uploaded thesis draft record for auditing history
model ThesisDraft {
  id                String   @id @default(cuid())
  fileName          String
  filePath          String   @default("")
  fileSize          Int      @default(0)
  textLength        Int      @default(0)
  aiScore           Int      @default(0) // computed AI written probability score (e.g. 18%)
  passiveVoiceCount Int      @default(0) // count of passive voice indicators
  longSentences     Int      @default(0) // count of sentences > 30 words
  citationCount     Int      @default(0) // count of total recognized citation formats
  unresolvedRefs    String   @default("") // comma-separated unresolved citation warnings
  createdAt         DateTime @default(now())
  thesis            Thesis   @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  thesisId          String
}

// Academic source – journal, book, conference paper, etc.
model Source {
  id            String   @id @default(cuid())
  title         String
  author        String   @default("")
  year          Int      @default(0)
  sourceType    String   @default("Journal Article")
  summary       String   @default("")
  keywords      String   @default("") // comma-separated for SQLite
  chapter       String   @default("")
  extractedText String   @default("")
  filePath      String   @default("") // local file path for uploaded docs
  createdAt     DateTime @default(now())
  annotations   Annotation[]
  thesis        Thesis   @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  thesisId      String
}

// Annotation notepad model linked to an individual source
model Annotation {
  id        String   @id @default(cuid())
  quote     String   // highlighted text fragment from source
  note      String   // student's active analytical reflection
  createdAt DateTime @default(now())
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId  String
}

// Supervisor comment linked to a chapter with status tracking
model Comment {
  id        String   @id @default(cuid())
  content   String
  chapter   String   @default("")
  status    String   @default("TODO")      // TODO | IN_PROGRESS | DONE
  priority  String   @default("MEDIUM")    // LOW | MEDIUM | HIGH
  createdAt DateTime @default(now())
  thesis    Thesis   @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  thesisId  String
}

// Literature matrix row – one per source analysis
model LiteratureMatrix {
  id            String @id @default(cuid())
  source        String
  method        String @default("")
  keyFindings   String @default("")
  limitations   String @default("")
  relevance     String @default("")
  citationUsage String @default("")
  thesis        Thesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  thesisId      String
}
